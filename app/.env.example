# Local development: copy to app/.env (backend commands run from app/).
# Production: Render → isobath-api → Environment (except NIGHTLY_DATABASE_URL / CHART_K).
# GitHub Actions triggers deployment but does NOT transfer these variables to Render.
# GitHub's NIGHTLY_DATABASE_URL secret is for the batch only; the API needs DATABASE_URL here.
# isobath_api role via Supavisor pooler (transaction mode)
# Copy the actual pooler host from Supabase Connect; aws-0-<region> below is a placeholder.
DATABASE_URL=postgresql://isobath_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
JWT_AUDIENCE=authenticated
# Local value below. On Render use:
# https://isobath.jocarium.productions,https://www.isobath.jocarium.productions
ALLOWED_ORIGINS=http://localhost:5173
LOG_SALT=change-me
# must stay false in production (rejects seeded *@isobath.local users)
ALLOW_TEST_USERS=false
# nightly batch only, local `pnpm batch` (production: GitHub secret NIGHTLY_DATABASE_URL,
# see ../.env.example): isobath_batch role
NIGHTLY_DATABASE_URL=
# public chart: hide density cells with fewer people (production: GitHub variable CHART_K)
CHART_K=10

# Emergency Mode
EMERGENCY_LEVEL=0
SIGNUP_ENABLED=true
SURVEY_WRITE_ENABLED=true
READ_ONLY_MODE=false
