{
	"name": "isobath",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.5.1",
	"scripts": {
		"dev": "pnpm run \"/^dev:/\"",
		"dev:web": "vite dev",
		"dev:api": "python -m uv --directory app run uvicorn isobath.main:app --reload --port 8000",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:reset": "supabase db reset",
		"db:migrate": "supabase migration up",
		"db:new": "supabase migration new",
		"db:status": "supabase migration list --linked",
		"db:plan": "supabase db push --dry-run",
		"db:push": "supabase db push --dry-run && supabase db push",
		"items:load": "python -m uv --directory app run python -m isobath.items",
		"batch": "python -m uv --directory app run python -m isobath.nightly",
		"test:api": "python -m uv --directory app run pytest",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && pnpm lint:api",
		"format": "prettier --write . && eslint --fix . && pnpm format:api",
		"lint:api": "python -m uv --directory app run ruff check && python -m uv --directory app run ruff format --check",
		"format:api": "python -m uv --directory app run ruff check --fix && python -m uv --directory app run ruff format",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/d3-contour": "^3.0.6",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"marked": "^18.0.13",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"supabase": "^2.117.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@lucide/svelte": "^1.47.0",
		"@supabase/supabase-js": "^2.116.0",
		"d3-contour": "^4.0.2"
	}
}
